# Copie este arquivo para api/.env e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > Database > Connection string (aba "Session pooler" recomendada)

DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO
DB_SSLMODE=require

# Em produção deixe false (não mostra detalhes de erros internos)
APP_DEBUG=false

# O front atual redefine senha só com e-mail + nova senha (sem confirmar por e-mail).
# Isso permite sequestrar qualquer conta. Deixe false em produção.
RESET_SENHA_SEM_EMAIL=true

# Só preencha se o front for servido em OUTRO domínio (ex: http://localhost:5500)
CORS_ORIGIN=
